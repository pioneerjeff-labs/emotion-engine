{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pioneerjeff-labs.github.io/emotion-engine/spec/emotion-state.schema.json",
  "title": "Emotion Engine State Protocol v3",
  "description": "Machine-readable schema for identity-bound Emotion Engine v3 state packets. v2 packets require an explicit, read-only migration preview before mutation.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "_schema",
    "identity",
    "capabilities",
    "enabled",
    "runtime_mode",
    "emotion",
    "personality_baseline",
    "character_profile",
    "trust",
    "trust_anchor",
    "session_count",
    "total_turns",
    "last_interaction_iso",
    "emotion_trajectory",
    "emotion_log",
    "trust_history",
    "trust_evidence",
    "trust_settlements",
    "session",
    "session_ledger",
    "processed_event_ids",
    "idempotency_retention",
    "log_limit"
  ],
  "properties": {
    "_schema": {
      "const": "emotion-engine-state/v3"
    },
    "identity": {
      "$ref": "#/$defs/stateIdentity"
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string"},
      "contains": {"const": "state_identity/v1"}
    },
    "enabled": {
      "type": "boolean"
    },
    "runtime_mode": {
      "type": "string",
      "enum": ["light", "always", "paused"]
    },
    "volatility_profile": {
      "description": "Host-selected expressiveness envelope for mood inertia and short-lived affective pulse visibility.",
      "type": "string",
      "enum": [
        "steady",
        "expressive",
        "dramatic_test"
      ]
    },
    "emotion": {
      "$ref": "#/$defs/padState"
    },
    "affective_pulse": {
      "$ref": "#/$defs/affectivePulse"
    },
    "personality_baseline": {
      "$ref": "#/$defs/padState"
    },
    "character_profile": {
      "$ref": "#/$defs/characterProfile"
    },
    "trust": {
      "description": "Slow-moving agent-to-user relationship continuity coefficient. This is the agent/persona's internal continuity estimate; it does not infer the user's trust in the agent.",
      "type": "number",
      "minimum": 0.05,
      "maximum": 1.0
    },
    "trust_anchor": {
      "description": "Highest agent-to-user trust level reached, used as a floor reference for trust decay.",
      "type": "number",
      "minimum": 0.05,
      "maximum": 1.0
    },
    "session_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_turns": {
      "type": "integer",
      "minimum": 0
    },
    "last_interaction_iso": {
      "$ref": "#/$defs/nullableIsoTimestamp"
    },
    "emotion_trajectory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/emotionTrajectoryEntry"
      }
    },
    "emotion_log": {
      "description": "Compact affective/provenance log for explaining PAD and trust changes. This is the semantic explanation layer; do not store full transcripts.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/emotionLogEntry"
      }
    },
    "trust_history": {
      "description": "Numeric ledger of applied trust changes. Automatic settlements reference authoritative trust_evidence ids.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/trustHistoryEntry"
      }
    },
    "trust_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/trustEvidence"}
    },
    "trust_settlements": {
      "type": "array",
      "items": {"$ref": "#/$defs/trustSettlement"}
    },
    "session": {
      "$ref": "#/$defs/sessionState"
    },
    "session_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/sessionLedgerEntry"}
    },
    "processed_event_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "idempotency_retention": {
      "$ref": "#/$defs/idempotencyRetention"
    },
    "log_limit": {
      "type": "integer",
      "minimum": 25
    },
    "boundary_state": {
      "description": "Optional adapter-owned boundary continuity extension. The core helper may omit it, but readers should preserve it when present.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/boundaryState"
        }
      ]
    }
  },
  "$defs": {
    "idempotencyRetention": {
      "description": "Bounded replay-protection window. Exact duplicate rejection applies to retained ids; pruning counters make older-window expiry observable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "session_limit", "event_limit", "pruned_sessions", "pruned_events", "pruned_evidence", "pruned_settlements", "last_pruned_at"],
      "properties": {
        "scope": {"const": "retained_window"},
        "session_limit": {"type": "integer", "minimum": 1},
        "event_limit": {"type": "integer", "minimum": 4},
        "pruned_sessions": {"type": "integer", "minimum": 0},
        "pruned_events": {"type": "integer", "minimum": 0},
        "pruned_evidence": {"type": "integer", "minimum": 0},
        "pruned_settlements": {"type": "integer", "minimum": 0},
        "last_pruned_at": {"$ref": "#/$defs/nullableIsoTimestamp"}
      }
    },
    "stateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "character_id", "relationship_id", "status"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "character_id": {"type": ["string", "null"]},
        "relationship_id": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["bound", "unbound"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "bound"}}},
          "then": {
            "properties": {
              "character_id": {"type": "string", "minLength": 1},
              "relationship_id": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "sessionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_session_id", "last_session_id", "status", "opened_at", "closed_at", "settled_at"],
      "properties": {
        "active_session_id": {"type": ["string", "null"]},
        "last_session_id": {"type": ["string", "null"]},
        "status": {"type": "string", "enum": ["active", "closing", "closed"]},
        "opened_at": {"$ref": "#/$defs/nullableIsoTimestamp"},
        "closed_at": {"$ref": "#/$defs/nullableIsoTimestamp"},
        "settled_at": {"$ref": "#/$defs/nullableIsoTimestamp"}
      }
    },
    "sessionLedgerEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["session_id", "status", "opened_at", "turn_count"],
      "properties": {
        "session_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["active", "closing", "closed", "settled"]},
        "opened_at": {"type": "string", "format": "date-time"},
        "closed_at": {"$ref": "#/$defs/nullableIsoTimestamp"},
        "settled_at": {"$ref": "#/$defs/nullableIsoTimestamp"},
        "turn_count": {"type": "integer", "minimum": 0},
        "settlement_id": {"type": ["string", "null"]},
        "settlement_event_id": {"type": ["string", "null"]}
      }
    },
    "trustEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evidence_id", "session_id", "event_id", "evidence_type", "direction", "weight", "eligible", "created_at", "consumed_by_settlement_id"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "enum": ["explicit_trust", "conflict_repair", "boundary_pressure", "hostility"]},
        "direction": {"type": "integer", "enum": [-1, 1]},
        "weight": {"type": "number", "minimum": 0, "maximum": 0.2},
        "eligible": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"},
        "consumed_by_settlement_id": {"type": ["string", "null"]}
      }
    },
    "trustEvidenceInput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["evidence_id", "evidence_type", "eligible"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "enum": ["explicit_trust", "conflict_repair", "boundary_pressure", "hostility"]},
        "weight": {"type": "number", "minimum": 0, "maximum": 0.2},
        "eligible": {"const": true},
        "source": {"type": "string"}
      }
    },
    "trustSettlement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["settlement_id", "session_id", "raw_delta", "evidence_ids", "status"],
      "properties": {
        "settlement_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "raw_delta": {"type": "number", "minimum": -0.2, "maximum": 0.05},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "status": {"const": "settled"}
      }
    },
    "nullableIsoTimestamp": {
      "description": "Timezone-aware ISO 8601 timestamp, or null when no event has occurred yet.",
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "padState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pleasure",
        "arousal",
        "dominance"
      ],
      "properties": {
        "pleasure": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "arousal": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "dominance": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "compactPadState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P",
        "A",
        "D"
      ],
      "properties": {
        "P": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "A": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "D": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "compactPadDelta": {
      "description": "Compact PAD movement delta. Unlike absolute PAD state, all dimensions may move negative or positive.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P",
        "A",
        "D"
      ],
      "properties": {
        "P": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "A": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "D": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        }
      }
    },
    "characterProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "description",
        "interpretation",
        "traits"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "interpretation": {
          "type": "string"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "emotionTrajectoryEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "turn",
        "P",
        "A",
        "D",
        "timestamp"
      ],
      "properties": {
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "session_id": {"type": "string"},
        "event_id": {"type": "string"},
        "subject": {"type": "string", "enum": ["task", "relationship", "self", "mixed"]},
        "semantic_event_type": {"type": "string"},
        "P": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "A": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "D": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "pulse": {
          "$ref": "#/$defs/affectivePulse"
        },
        "appraisal": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        }
      }
    },
    "emotionLogEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "timestamp",
        "event_type"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "event_type": {
          "type": "string"
        },
        "trust": {
          "description": "Agent-to-user trust value at the time of this emotion log entry.",
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "turn": {
          "type": "integer",
          "minimum": 1
        },
        "situation": {
          "type": "string"
        },
        "character_lens": {
          "type": "string"
        },
        "relational_meaning": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "open_loop": {
          "type": "boolean"
        },
        "follow_up_bias": {
          "type": "string"
        },
        "salience": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "appraisal": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/compactPadState"
        },
        "after": {
          "$ref": "#/$defs/compactPadState"
        },
        "delta": {
          "$ref": "#/$defs/compactPadDelta"
        },
        "affective_pulse": {
          "$ref": "#/$defs/affectivePulse"
        },
        "pulse_before": {
          "$ref": "#/$defs/affectivePulse"
        },
        "pulse_after": {
          "$ref": "#/$defs/affectivePulse"
        },
        "volatility_profile": {
          "type": "string",
          "enum": [
            "steady",
            "expressive",
            "dramatic_test"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "description": "Optional references to external memory, journal, turn, or audit records. References should point outward rather than duplicate private transcript text.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "affectivePulse": {
      "description": "Short-lived visible affective movement for the latest event. It complements slow PAD mood and should not be treated as durable relationship state.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "P",
        "A",
        "D",
        "intensity",
        "label",
        "source",
        "created_at"
      ],
      "properties": {
        "P": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "A": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "D": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "intensity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/nullableIsoTimestamp"
        }
      }
    },
    "trustHistoryEntry": {
      "description": "Numeric ledger entry for an applied trust update. Automatic settlements reference authoritative trust_evidence ids.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "old",
        "new",
        "raw_delta",
        "effective_delta"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "old": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "new": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "raw_delta": {
          "type": "number"
        },
        "effective_delta": {
          "type": "number"
        },
        "session_id": {"type": ["string", "null"]},
        "settlement_id": {"type": ["string", "null"]},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "sourceRef": {
      "description": "External provenance pointer for host memory, journal, turn, or audit records.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "boundaryState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "clear",
            "watch",
            "strained",
            "repairing"
          ]
        },
        "firmness": {
          "description": "How firmly the agent should maintain standing boundaries, not a policy decision.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "recent_pressure": {
          "description": "Recent boundary pressure signal in the current relationship state.",
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "standing_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standingBoundary"
          }
        },
        "last_updated_iso": {
          "$ref": "#/$defs/nullableIsoTimestamp"
        },
        "provenance": {
          "type": "string"
        }
      }
    },
    "standingBoundary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "softened",
            "retired"
          ]
        },
        "source": {
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/nullableIsoTimestamp"
        }
      }
    },
    "adapterEvent": {
      "description": "Raw, identity-bound lifecycle or turn envelope. Hosts must preserve native identifiers and explicitly approve emotional recording.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "_schema",
        "event_type",
        "event_id",
        "session_id",
        "character_id",
        "relationship_id"
      ],
      "properties": {
        "_schema": {
          "const": "emotion-engine-adapter-event/v2"
        },
        "source": {
          "type": "string"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "session_start",
            "turn",
            "session_end",
            "trust_settlement",
            "pre_turn_decay"
          ]
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "$ref": "#/$defs/nullableIsoTimestamp"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "character_id": {"type": "string", "minLength": 1},
        "relationship_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "enum": ["task", "relationship", "self", "mixed"]},
        "semantic_event_type": {"type": "string"},
        "host_approved": {"type": "boolean"},
        "memory_owner": {"type": "string"},
        "trust_evidence": {
          "oneOf": [
            {"$ref": "#/$defs/trustEvidenceInput"},
            {"type": "array", "items": {"$ref": "#/$defs/trustEvidenceInput"}}
          ]
        },
        "turn_id": {
          "type": "string"
        },
        "limbicState": {
          "oneOf": [
            {
              "$ref": "#/$defs/padState"
            },
            {
              "$ref": "#/$defs/compactPadState"
            }
          ]
        },
        "limbic_state": {
          "oneOf": [
            {
              "$ref": "#/$defs/padState"
            },
            {
              "$ref": "#/$defs/compactPadState"
            }
          ]
        },
        "pad": {
          "oneOf": [
            {
              "$ref": "#/$defs/padState"
            },
            {
              "$ref": "#/$defs/compactPadState"
            }
          ]
        },
        "appraisal": {
          "type": "string"
        },
        "compact_memory": {
          "$ref": "#/$defs/emotionLogEntry"
        },
        "trust_delta": {
          "type": "number",
          "minimum": -1.0,
          "maximum": 1.0
        },
        "boundary_state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/boundaryState"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        }
      }
    },
    "adapterOutput": {
      "description": "Recommended output envelope from an Emotion Engine adapter back to the host runtime.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "_schema",
        "state_schema",
        "snapshot",
        "prompt_prelude"
      ],
      "properties": {
        "_schema": {
          "const": "emotion-engine-adapter-output/v2"
        },
        "state_schema": {
          "const": "emotion-engine-state/v3"
        },
        "state_patch": {
          "type": "object",
          "additionalProperties": true
        },
        "snapshot": {
          "$ref": "#/$defs/compactSnapshot"
        },
        "prompt_prelude": {
          "type": "string"
        },
        "emotion_log_entry": {
          "$ref": "#/$defs/emotionLogEntry"
        },
        "journal_suggestion": {
          "$ref": "#/$defs/emotionLogEntry"
        }
      }
    },
    "compactSnapshot": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tone": {
          "type": "string"
        },
        "emotion": {
          "$ref": "#/$defs/padState"
        },
        "affective_pulse": {
          "$ref": "#/$defs/affectivePulse"
        },
        "volatility_profile": {
          "type": "string",
          "enum": [
            "steady",
            "expressive",
            "dramatic_test"
          ]
        },
        "trust": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1.0
        },
        "trust_tier": {
          "type": "string"
        },
        "recent_memories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/emotionLogEntry"
          }
        },
        "boundary_state": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/boundaryState"
            }
          ]
        }
      }
    }
  }
}
